  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>APCS.Infrastructure</AssemblyName>
    <RootNamespace>APCS.Infrastructure</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
