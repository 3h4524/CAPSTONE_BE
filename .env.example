# Copy this file to .env and replace development placeholders locally.
# Never commit .env or real credentials.

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=apcs;Username=postgres;Password=replace-me

Jwt__Issuer=APCS
Jwt__Audience=APCS.Web
# Development placeholder only. Use a random secret of at least 32 bytes.
Jwt__SigningKey=replace-with-a-development-key-at-least-32-bytes
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

Redis__ConnectionString=localhost:6379
Redis__InstanceName=APCS:
Redis__DefaultExpirationMinutes=10

# Optional. Separate multiple origins with semicolons.
Cors__AllowedOrigins=http://localhost:3000;http://localhost:5173
