# Copy this file to .env and replace development placeholders locally.
# Never commit .env or real credentials.

# Npgsql key/value format. Keep the real Neon credentials in the ignored .env file only.
ConnectionStrings__DefaultConnection=Host=<neon-host>;Database=<database>;Username=<username>;Password=<password>;SSL Mode=Require;Channel Binding=Require

Jwt__Issuer=APCS
Jwt__Audience=APCS.Web
# Development placeholder only. Use a random secret of at least 32 bytes.
Jwt__SigningKey=replace-with-a-development-key-at-least-32-bytes
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
# Email verification link lifetime. Defaults to 24 hours.
Jwt__EmailVerificationHours=24
# Password reset link lifetime. Defaults to 10 minutes.
Jwt__PasswordResetMinutes=10

# Client application address used to build emailed links.
App__BaseUrl=http://localhost:3000
App__VerifyEmailPath=/verify-email
App__ResetPasswordPath=/reset-password

# Optional outgoing mail server. Leave Smtp__Host empty to log verification emails
# instead of sending them, which is the default for local development.
# Port 587 negotiates STARTTLS; port 465 connects over TLS directly.
# Gmail requires an app password (myaccount.google.com/apppasswords), not the account
# password, and FromAddress must match Username.
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=APCS

Redis__ConnectionString=localhost:6379
Redis__InstanceName=APCS:
Redis__DefaultExpirationMinutes=10

# Optional. Separate multiple origins with semicolons.
Cors__AllowedOrigins=http://localhost:3000;http://localhost:5173

# Optional. Google Sign-In client ID (OAuth 2.0 Client ID, Web application type) from
# https://console.cloud.google.com/apis/credentials. Leave empty to keep Google sign-in disabled.
# Must match the client ID the frontend uses (NEXT_PUBLIC_GOOGLE_CLIENT_ID).
Authentication__Google__ClientId=

# Optional. PayOS payment channel credentials from my.payos.vn -> "Kênh thanh toán" ->
# "Tạo kênh thanh toán" (requires org verification + a linked bank account first). Leave empty
# to keep real checkout disabled — PayOsGatewayClient will fail every checkout attempt.
# PayOS HAS NO SANDBOX: every checkout is a real bank transfer once these are set.
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
# USD -> VND conversion rate used to price a checkout (plans are stored in USD; PayOS is VND-only).
PayOS__UsdToVndRate=25000
# Safety valve for local testing: when set, every checkout charges this fixed VND amount instead
# of the real converted plan price. Leave empty/unset wherever real prices should actually apply.
PayOS__TestAmountVnd=2000

# Cloudinary private attachment storage. Keep credentials empty until configured locally.
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__Folder=apcs
Cloudinary__SignedUrlTtlMinutes=10
