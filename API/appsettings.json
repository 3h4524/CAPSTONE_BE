{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "TestReports": {
    "RunnerCommand": "dotnet test tests/APCS.E2E.Automation/APCS.E2E.Automation.csproj --nologo",
    "FrontendRoot": "../CAPSTONE_FE",
    "ReportFileName": "test-results/report/report.json",
    "TimeoutMinutes": 90
  },
  "Rag": {
    "Cache": {
      "Enabled": true,
      "EmbeddingTtlHours": 24,
      "SearchTtlMinutes": 10
    },
    "Retrieval": {
      "MinimumSimilarity": 0.55,
      "MaxChunksPerDocument": 2,
      "CandidateMultiplier": 10,
      "LexicalWeight": 0.25,
      "ViralWeight": 0.15,
      "FreshnessWeight": 0.15,
      "FreshnessHalfLifeDays": 30
    }
  },
  "Etsy": {
    "BaseUrl": "https://api.etsy.com/v3/application/",
    "RequestTimeoutSeconds": 30
  },
  "MarketResearch": {
    "Scheduled": {
      "Enabled": false,
      "Platform": 1,
      "Queries": [],
      "LimitPerQuery": 25,
      "MinimumViralScore": 50,
      "TopN": 3,
      "IntervalMinutes": 1440
    }
  },
  "Assistant": {
    "Model": "gemini-3.5-flash",
    "Temperature": 0.3,
    "MaxOutputTokens": 2048
  },
  "Gemini": {
    "Embeddings": {
      "Model": "gemini-embedding-001",
      "Dimensions": 1536,
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/"
    },
    "TextGeneration": {
      "Model": "gemini-3.5-flash",
      "FallbackModel": "gemini-3.5-flash-lite",
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/",
      "Temperature": 0.7
    }
  }
}
