{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "TestReports": {
    "RunnerCommand": "dotnet test tests/APCS.E2E.Automation/APCS.E2E.Automation.csproj --nologo",
    "FrontendRoot": "../CAPSTONE_FE",
    "ReportFileName": "test-results/report/report.json",
    "TimeoutMinutes": 90
  },
  "UsageAllowances": {
    "Free": {
      "FullRuns": 2,
      "DesignRuns": 5,
      "DesignImages": 7,
      "Mockups": 6,
      "Videos": 2,
      "Listings": 5
    },
    "Trial": {
      "ProductsPerRun": 3,
      "Products": 10,
      "DesignImages": 40,
      "Mockups": 100,
      "Videos": 10,
      "Listings": 20
    }
  },
  "PlanInsights": {
    "MinimumSample": 20,
    "PremiumPriceRatio": 1.5,
    "LowRetentionRate": 60,
    "PromoteBelowRate": 30
  },
  "PlanAiReview": {
    "Enabled": true,
    "RefreshIntervalDays": 14,
    "RetryAfterFailureHours": 24,
    "ManualRegenerateCooldownHours": 0,
    "Model": "gemini-3.5-flash",
    "FallbackModel": "gemini-3.5-flash",
    "AttemptTimeoutSeconds": 300,
    "MaxGenerations": 2
  },
  "Rag": {
    "Cache": {
      "Enabled": true,
      "EmbeddingTtlHours": 24,
      "SearchTtlMinutes": 10
    },
    "Retrieval": {
      "MinimumSimilarity": 0.55,
      "MaxChunksPerDocument": 2,
      "CandidateMultiplier": 10,
      "LexicalWeight": 0.25,
      "ViralWeight": 0.15,
      "FreshnessWeight": 0.15,
      "FreshnessHalfLifeDays": 30
    }
  },
  "VideoQuality": {
    "Enabled": false,
    "AutoEvaluate": true,
    "WorkerUrl": "",
    "WorkerToken": "",
    "WorkerTimeoutSeconds": 3600,
    "PollIntervalSeconds": 3,
    "PythonExecutable": "python",
    "PaddleOcrScriptPath": "",
    "VBenchScriptPath": "",
    "TimeoutSeconds": 90
  },
  "Etsy": {
    "BaseUrl": "https://api.etsy.com/v3/application/",
    "RequestTimeoutSeconds": 30
  },
  "Translation": {
    "Provider": "google",
    "Endpoint": "https://translation.googleapis.com/language/translate/v2"
  },
  "MarketResearch": {
    "Scheduled": {
      "Enabled": false,
      "Platform": 1,
      "Queries": [
        "personalized t shirt",
        "graphic t shirt",
        "embroidered sweatshirt",
        "custom hoodie",
        "oversized sweatshirt",
        "vintage shirt",
        "funny teacher shirt",
        "mom shirt",
        "dad shirt",
        "dog mom shirt",
        "cat mom shirt",
        "wedding party shirts",
        "bridesmaid shirt",
        "bachelorette shirt",
        "personalized couple sweatshirt",
        "family reunion shirts",
        "matching family shirts",
        "custom name shirt",
        "birth flower shirt",
        "zodiac shirt",
        "book lover shirt",
        "plant lover shirt",
        "gardener shirt",
        "cottagecore shirt",
        "gothic shirt",
        "minimalist typography shirt",
        "funny quote shirt",
        "christmas sweatshirt",
        "halloween sweatshirt",
        "christmas family shirt",
        "teacher sweatshirt",
        "nurse sweatshirt",
        "nurse shirt",
        "bridal sweatshirt",
        "honeymoon shirt",
        "pet memorial sweatshirt",
        "custom pet portrait shirt",
        "embroidered tote bag",
        "personalized tote bag",
        "canvas tote bag",
        "embroidered hat",
        "custom baseball cap",
        "trucker hat",
        "personalized beanie",
        "crochet cardigan",
        "knit sweater",
        "patchwork jacket",
        "denim jacket patch",
        "embroidered jacket",
        "linen apron",
        "personalized apron",
        "baby bodysuit",
        "baby name sweatshirt",
        "kids birthday shirt",
        "toddler shirt",
        "matching couple shirts",
        "custom sports jersey",
        "team sweatshirt",
        "tie dye shirt",
        "screen print shirt"
      ],
      "LimitPerQuery": 100,
      "MinimumViralScore": 60,
      "TopN": 5,
      "IntervalMinutes": 5,
      "BatchSize": 10,
      "RunWindowMinutes": 10080
    }
  },
  "Assistant": {
    "Model": "gemini-3.5-flash",
    "Temperature": 0.3,
    "MaxOutputTokens": 2048
  },
  "Gemini": {
    "Embeddings": {
      "Model": "gemini-embedding-001",
      "Dimensions": 1536,
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/"
    },
    "TextGeneration": {
      "Model": "gemini-3.5-flash",
      "FallbackModel": "gemini-3.5-flash-lite",
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/",
      "Temperature": 0.7
    }
  }
}
