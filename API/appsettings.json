{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "Rag": {
    "Retrieval": {
      "MinimumSimilarity": 0.55,
      "MaxChunksPerDocument": 2,
      "CandidateMultiplier": 10,
      "LexicalWeight": 0.25
    }
  },
  "Gemini": {
    "Embeddings": {
      "Model": "gemini-embedding-001",
      "Dimensions": 1536,
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/"
    },
    "TextGeneration": {
      "Model": "gemini-3.8-flash",
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/",
      "Temperature": 0.7
    }
  }
}
