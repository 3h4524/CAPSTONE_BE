  "TestReports": {
    "RunnerCommand": "dotnet test tests/APCS.E2E.Automation/APCS.E2E.Automation.csproj --nologo",
    "FrontendRoot": "../CAPSTONE_FE",
    "ReportFileName": "test-results/report/report.json",
    "TimeoutMinutes": 90
  },
  "UsageAllowances": {
    "Free": {
      "FullRuns": 2,
      "DesignRuns": 5,
      "DesignImages": 7,
      "Mockups": 6,
      "Videos": 2,
      "Listings": 5
    },
    "Trial": {
      "ProductsPerRun": 3,
      "Products": 10,
      "DesignImages": 40,
      "Mockups": 100,
      "Videos": 10,
      "Listings": 20
    }
  },
  "PlanInsights": {
    "MinimumSample": 20,
    "PremiumPriceRatio": 1.5,
    "LowRetentionRate": 60,
    "PromoteBelowRate": 30
  },
  "PlanAiReview": {
    "Enabled": true,
    "RefreshIntervalDays": 14,
    "RetryAfterFailureHours": 24,
    "ManualRegenerateCooldownHours": 0,
    "Model": "gemini-3.5-flash",
    "FallbackModel": "gemini-3.5-flash",
    "AttemptTimeoutSeconds": 300,
    "MaxGenerations": 2
  },
  "Rag": {
    "Cache": {
      "Enabled": true,
      "EmbeddingTtlHours": 24,
      "SearchTtlMinutes": 10
    },
    "Retrieval": {
      "MinimumSimilarity": 0.55,
      "MaxChunksPerDocument": 2,
      "CandidateMultiplier": 10,
      "LexicalWeight": 0.25,
      "ViralWeight": 0.15,
      "FreshnessWeight": 0.15,
      "FreshnessHalfLifeDays": 30
    }
  },
  "DesignTextCheck": {
    "Enabled": false,
    "PythonExecutable": "python",
    "ScriptPath": "tools/design-text-check/ocr_worker.py",
    "Language": "en",
    "StartupTimeoutSeconds": 300,
    "TimeoutSeconds": 90
