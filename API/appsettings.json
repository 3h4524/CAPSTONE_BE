{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "Gemini": {
    "Embeddings": {
      "Model": "gemini-embedding-001",
      "Dimensions": 1536,
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/"
    },
    "TextGeneration": {
      "Model": "gemini-3.5-flash",
      "FallbackModel": "gemini-3.5-flash-lite",
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/",
      "Temperature": 0.7
    }
  }
}
