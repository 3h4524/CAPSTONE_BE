APCS_API_URL=http://host.docker.internal:5191
MEDIA_WORKER_API_KEY=replace-with-the-same-random-32-to-256-character-secret-as-the-api
AI_SCENE_CONCURRENCY=1
AI_SHOT_FIRST_POLL_SECONDS=30
AI_SHOT_POLL_SECONDS=10
AI_SHOT_TIMEOUT_MINUTES=25
# Optional. Leave CHROME_EXECUTABLE unset to use Remotion's Chrome Headless Shell (the fast default).
# Optional x264 preset for the rendered video (ultrafast..veryslow). Unset keeps Remotion's default, so file size does not change.
# RENDER_X264_PRESET=
